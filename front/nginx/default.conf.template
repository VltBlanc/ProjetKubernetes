# Configuration nginx du front en production.
# Modèle lu par l'image officielle nginx : au démarrage, ${GATEWAY_URL} est remplacé
# par la variable d'environnement du conteneur, et le résultat est écrit dans
# /etc/nginx/conf.d/default.conf. À copier dans /etc/nginx/templates/ de l'image.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # L'appli React (une seule page)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Les appels à l'API sont relayés à la gateway (utile sans Ingress, ex. docker compose)
    location /api/ {
        proxy_pass ${GATEWAY_URL};
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
